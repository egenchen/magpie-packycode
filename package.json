    "prices": "node scripts/prices.mjs",
    "live": "node scripts/live.mjs",
    "live:plugin": "node scripts/live-plugin.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-plugin",
    "packyapi",
    "packycode",
    "new-api",
    "relay",
    "provider",
    "routing",
    "cheapest"
  ],
